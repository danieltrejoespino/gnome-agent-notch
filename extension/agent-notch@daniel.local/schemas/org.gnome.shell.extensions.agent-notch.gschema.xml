<?xml version="1.0" encoding="UTF-8"?>
<!-- agent-notch settings (docs/20-preferencias.md). Edited by prefs.js. -->
<schemalist gettext-domain="agent-notch">
  <schema id="org.gnome.shell.extensions.agent-notch" path="/org/gnome/shell/extensions/agent-notch/">

    <!-- Tabs: a module that is turned off is not created. -->
    <key name="modulo-musica" type="b">
      <default>true</default>
      <summary>Music</summary>
    </key>
    <key name="modulo-sistema" type="b">
      <default>true</default>
      <summary>System</summary>
    </key>
    <key name="modulo-agentes" type="b">
      <default>true</default>
      <summary>Agents</summary>
    </key>
    <key name="modulo-docker" type="b">
      <default>true</default>
      <summary>Docker</summary>
    </key>
    <key name="modulo-portapapeles" type="b">
      <default>true</default>
      <summary>Clipboard</summary>
    </key>
    <key name="modulo-concentracion" type="b">
      <default>true</default>
      <summary>Focus</summary>
    </key>

    <!-- Agent alerts: read at the moment of the alert. -->
    <key name="sonido-atencion" type="b">
      <default>true</default>
      <summary>Sound when an agent needs you</summary>
    </key>
    <key name="banner-atencion" type="b">
      <default>true</default>
      <summary>Banner when an agent needs you</summary>
    </key>
    <key name="banner-segundos" type="i">
      <range min="2" max="30"/>
      <default>5</default>
      <summary>Seconds the banner stays</summary>
    </key>

    <!-- Appearance. -->
    <key name="agentes-dos-lineas" type="b">
      <default>true</default>
      <summary>Agents on two lines (eyes on top, text below)</summary>
    </key>
    <key name="animar-ojos" type="b">
      <default>true</default>
      <summary>Blink, pulse and flash of the eyes</summary>
    </key>

    <!-- Shortcuts and updates. -->
    <key name="atajo-portapapeles" type="b">
      <default>true</default>
      <summary>Super+V opens the Clipboard</summary>
    </key>
    <key name="aviso-actualizaciones" type="b">
      <default>true</default>
      <summary>Daily notice and button for new versions</summary>
    </key>
  </schema>
</schemalist>
